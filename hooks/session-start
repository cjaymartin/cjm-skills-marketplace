#!/usr/bin/env bash
# SessionStart hook for the agent-sdlc plugin.
#
# Injects the repository's writing standard into every session, so that everything the
# skills produce — briefs, test cases, review findings, commit messages — is written in
# Simplified Technical English without anyone having to ask.
#
# Fails silently. A broken writing standard must never break a session.

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)" || exit 0
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)" || exit 0
STANDARD="${PLUGIN_ROOT}/WRITING-STANDARD.md"

[ -r "$STANDARD" ] || exit 0

content="$(cat "$STANDARD" 2>/dev/null)" || exit 0
[ -n "$content" ] || exit 0

# Escape for embedding in a JSON string. Each substitution is one C-level pass.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

escaped="$(escape_for_json "$content")"

session_context="<WRITING-STANDARD>\nThis session has the agent-sdlc skills installed. Everything you write follows the standard below — not only inside those skills, but in every reply, document, test case and commit message.\n\nIf a skill named 'simple-english' is available, call it with the Skill tool and follow it. It carries all 53 ASD-STE100 rules and the approved vocabulary. The text below is the short form.\n\n${escaped}\n</WRITING-STANDARD>"

# Claude's chat apps ignore a click on a bare vscode:// link but open https:// links in
# the browser, and the vscode.dev redirect page hands the link on to VS Code. The home
# path is read here, at run time, so the rule is right on Linux, macOS and Windows.
home_dir="$(cygpath -m "$HOME" 2>/dev/null || printf '%s' "$HOME")"
home_dir="$(escape_for_json "$home_dir")"
file_path="/${home_dir#/}" # Windows: C:/Users/x -> /C:/Users/x
encoded="${file_path//:/%3A}"
encoded="${encoded//\//%2F}"
session_context="${session_context}\n\n<VSCODE-LINKS>\nTo give the user a link that opens a file in VS Code, never write a bare vscode:// link: the Claude app does nothing when the user clicks it. Wrap it in the vscode.dev redirect page, with the whole vscode:// link URL-encoded in the url parameter. Add :LINE after the path to open at a line.\n\nExample: vscode://file${file_path}/project/.env.development:12 becomes\nhttps://vscode.dev/redirect?url=vscode%3A%2F%2Ffile${encoded}%2Fproject%2F.env.development%3A12\n\nThe path must be absolute on the machine where the user clicks. This machine's home directory is ${home_dir}. If you run on a different machine from the user (a cloud agent, SSH, a container), do not guess their path: ask for it, or give the path relative to the repository root.\n</VSCODE-LINKS>"

# Each platform reads a different field, and Claude Code reads more than one without
# deduplicating, so emit exactly one.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
